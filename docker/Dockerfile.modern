# Dockerfile.modern — GNU Radio + UHD Android cross-compile toolchain image.
#
# Provides only the *build environment* (Ubuntu + NDK + JDK 17 + SDK + cmake).
# The arm64-v8a .so set (libuhd, libgnuradio-*, libvolk, …) is cross-compiled by
# build_aarch64_modern.sh against the pinned submodules into
# toolchain/arm64-v8a-modern/. The repo source is bind-mounted at run time, not
# baked into the image (so the image is independent of the source tree size).

FROM ubuntu:26.04

LABEL org.opencontainers.image.description="GNU Radio 3.10 + UHD 4.10 Android (arm64-v8a) cross-compile toolchain"

ARG USER=android
# NDK r26d (SDK package 26.3.11579264).
ARG NDK_PKG_VERSION=26.3.11579264
# Android SDK cmake 3.22.1 (the cmdline-tools default; satisfies GR 3.10's
# >= 3.16 requirement).
ARG SDK_CMAKE_VERSION=3.22.1
# compileSdk / build-tools the apps build against.
ARG ANDROID_API=35
ARG ANDROID_BUILD_TOOLS=35.0.0

ENV DEBIAN_FRONTEND=noninteractive

# Build + cross-build host tooling. Single JDK 17 — AGP 8.x, Gradle 8.x and the
# 2024 cmdline-tools (sdkmanager, class-major-61 bytecode) all require it.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git wget unzip zip sudo vim \
        build-essential ninja-build pkg-config \
        autoconf automake libtool m4 \
        bison flex texinfo \
        python3 python3-mako python3-numpy python3-setuptools \
        swig \
        openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# ubuntu:26.04 ships a default `ubuntu` user at UID/GID 1000 — remove it so
# `android` can own 1000 (matches the host user, needed for bind-mounted source
# ownership).
RUN userdel -r ubuntu 2>/dev/null || true \
    && groupdel ubuntu 2>/dev/null || true \
    && groupadd -g 1000 ${USER} \
    && useradd -u 1000 -g 1000 --create-home ${USER} \
    && echo "${USER} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/90-${USER} \
    && usermod -aG sudo ${USER}

USER ${USER}
WORKDIR /home/${USER}

# AGP 8.x / Gradle 8.x / Kotlin / sdkmanager all run on JDK 17.
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH=${JAVA_HOME}/bin:${PATH}

ENV ANDROID_HOME=/home/${USER}/Android/Sdk
ENV ANDROID_SDK_ROOT=${ANDROID_HOME}

# Android SDK cmdline-tools (JDK 17 build). NDK, platform-tools, the apps'
# compileSdk / build-tools, and cmake all come from sdkmanager so AGP's
# externalNativeBuild and the native cross-build share one NDK + one CMake.
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
    && wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O /tmp/cmdtools.zip \
    && unzip -q /tmp/cmdtools.zip -d ${ANDROID_HOME}/cmdline-tools \
    && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
    && rm /tmp/cmdtools.zip

ENV PATH=${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${PATH}

RUN yes 2>/dev/null | sdkmanager --licenses >/dev/null 2>&1 || true \
    && sdkmanager \
        "platform-tools" \
        "platforms;android-${ANDROID_API}" \
        "build-tools;${ANDROID_BUILD_TOOLS}" \
        "ndk;${NDK_PKG_VERSION}" \
        "cmake;${SDK_CMAKE_VERSION}"

ENV ANDROID_NDK_ROOT=${ANDROID_HOME}/ndk/${NDK_PKG_VERSION}
ENV ANDROID_NDK_HOME=${ANDROID_NDK_ROOT}
ENV ANDROID_SDK_CMAKE=${ANDROID_HOME}/cmake/${SDK_CMAKE_VERSION}/bin
ENV PATH=${ANDROID_SDK_CMAKE}:${PATH}

WORKDIR /home/${USER}/src
ENTRYPOINT ["/bin/bash"]
